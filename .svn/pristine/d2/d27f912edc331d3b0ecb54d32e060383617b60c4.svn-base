<?
class utenti_gruppi_assegnatiInfo
{ 

		// Variables 
		var $Id_gruppo;
		var $Id_utente;


		/**
		* @return returns value of variable $Id_gruppo
		* @desc getId_gruppo : Getting value for variable $Id_gruppo
		*/
		function getId_gruppo()
		{
				return $this->Id_gruppo;
		}

		/**
		* @param param : value to be saved in variable $Id_gruppo
		* @desc setId_gruppo : Setting value for $Id_gruppo
		*/
		function setId_gruppo($value)
		{
				$this->Id_gruppo = $value;
		}

		/**
		* @return returns value of variable $Id_utente
		* @desc getId_utente : Getting value for variable $Id_utente
		*/
		function getId_utente()
		{
				return $this->Id_utente;
		}

		/**
		* @param param : value to be saved in variable $Id_utente
		* @desc setId_utente : Setting value for $Id_utente
		*/
		function setId_utente($value)
		{
				$this->Id_utente = $value;
		}

		// This is the constructor for this class
		// Initialize all your default variables here
		function utenti_gruppi_assegnatiInfo()
		{

				$this->setId_gruppo("");
				$this->setId_utente("");
		}

		// This function will clear all the values of variables in this class
		function emptyInfo()
		{

				$this->setId_gruppo("");
				$this->setId_utente("");
		}

} 

?>