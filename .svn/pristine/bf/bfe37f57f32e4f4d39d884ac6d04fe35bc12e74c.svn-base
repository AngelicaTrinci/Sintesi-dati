       function convertiDataExcelToDb($data) {
           if ($data == null)
               return null;
           $d = explode("/", $data);
           if (count($d) < 3) {
               $d = explode("-", $data);
               if (count($d) < 3)
                   return null;
           }
           $giorno = $d[1];
           if ($giorno < 10 && strlen($giorno) < 2) {
               $giorno = "0" . $giorno;
           }
           $mese = $d[0];
           if ($mese < 10 && strlen($mese) < 2) {
               $mese = "0" . $mese;
           }
           return $d[2] . "-" . $mese . "-" . $giorno;
       }

       function convertiTimeToOra($time) {
           if ($time == null || $time == "")
               return $time;
           if (DATABASE_SERVER_TO_USE == "mssqlnative") {
               //$data=str_replace(array("T","Z")," ", $data);
               $format = 'H:i:s';
               //echo $data;
               $date = new DateTime($time);
               $time = $date->format($format);
           }

           if (strpos($time, ".") > 0) {
               $time = explode(".", $time);
               return $time[0];
           }
           return $time;
       }

       function convertiDataItToDb($data) {
           if ($data == null)
               return null;
           $d = explode("/", $data);
           if (count($d) < 3) {
               $d = explode("-", $data);
               if (count($d) < 3)
                   return null;
           }
           $giorno = $d[0];
           if ($giorno < 10 && strlen($giorno) < 2) {
               $giorno = "0" . $giorno;
           }
           $mese = $d[1];
           if ($mese < 10 && strlen($mese) < 2) {
               $mese = "0" . $mese;
           }
           return $d[2] . "-" . $mese . "-" . $giorno;
       }

       function convertiDataDbToIt($data) {
           if ($data == null)
               return null;
           if (DATABASE_SERVER_TO_USE == "mssqlnative") {
               //$data=str_replace(array("T","Z")," ", $data);
               $format = 'Y-m-d';
               //echo $data;
               $date = new DateTime($data);
               $data = $date->format($format);
           }

           $d = explode("-", $data);
           if (count($d) < 3) {
               return null;
           }
           return $d[2] . "/" . $d[1] . "/" . $d[0];
       }

       function convertiData8ToDb($data){
           $anno = substr($data, 0, 4);
           $mese = substr($data, 4, 2);
           $giorno = substr($data, 6, 2);
           return "$anno-$mese-$giorno";
       }
       function convertiData8ToExternal($data){
           $anno = substr($data, 0, 4);
           $mese = substr($data, 4, 2);
           $giorno = substr($data, 6, 2);
           return "$giorno/$mese/$anno";
       }
       function convertiOra6ToExternal($ora){
           $ore = substr($ora, 0, 2);
           $minuti = substr($ora, 2, 2);
           return "$ore:$minuti";
       }
       
       function convertiDataDbToDate8($data) {
           if ($data == null)
               return null;
           if (DATABASE_SERVER_TO_USE == "mssqlnative") {
               //$data=str_replace(array("T","Z")," ", $data);
               $format = 'Y-m-d';
               //echo $data;
               $date = new DateTime($data);
               $data = $date->format($format);
           }

           $d = explode("-", $data);
           if (count($d) < 3) {
               return null;
           }
           return $d[0] . "" . $d[1] . "" . $d[2];
       }

       function convertiDataOraDbToIt($data) {


           if ($data == null)
               return null;
           if (DATABASE_SERVER_TO_USE == "mysql" || DATABASE_SERVER_TO_USE == "mysqli") {
               
           } else if (DATABASE_SERVER_TO_USE == "mssqlnative") {
               //$data=str_replace(array("T","Z")," ", $data);
               $format = 'Y-m-d H:i:s';
               //echo $data;
               $date = new DateTime($data);
               $fuso = -((integer) (date("O") / 100));
               if ($fuso >= 0)
                   $fuso = "+" . $fuso;
               $date->modify($fuso . " hours");
               $data = $date->format($format);
           }
           else {
               $format = 'Y-m-d H:i:s';
               $date = DateTime::createFromFormat($format, $data);
               $fuso = -((integer) (date("O") / 100));
               if ($fuso >= 0)
                   $fuso = "+" . $fuso;
               $date->modify($fuso . " hours");
               $data = $date->format($format);
           }



           $d = explode(" ", $data);
           return convertiDataDbToIt($d[0]) . " " . convertiTimeToOra($d[1]);
       }

       function convertiDataOraDbToUTC($data) {

           if ($data == null)
               return null;
           if (DATABASE_SERVER_TO_USE == "mysql" || DATABASE_SERVER_TO_USE == "mysqli") {
               
           } else if (DATABASE_SERVER_TO_USE == "mssqlnative") {
               //$data=str_replace(array("T","Z")," ", $data);
               $format = 'Y-m-d H:i:s';
               //echo $data;
               $date = new DateTime($data);
               $fuso = -((integer) (date("O") / 100));
               if ($fuso >= 0)
                   $fuso = "+" . $fuso;
               $date->modify($fuso . " hours");
               $data = $date->format($format);
           }else {
               $format = 'Y-m-d H:i:s';
               $date = DateTime::createFromFormat($format, $data);
               $fuso = -((integer) (date("O") / 100));
               if ($fuso >= 0)
                   $fuso = "+" . $fuso;
               $date->modify($fuso . " hours");
               $data = $date->format($format);
           }



           $d = explode(" ", $data);
           return $d[0] . "T" . convertiTimeToOra($d[1]);
       }

       function convertiDataOraUTCtoDb($data) {

           $d = explode("T", $data);
           $d1 = explode("+", $d(1));
           return $d[0] . " " . $d1[0];
       }

