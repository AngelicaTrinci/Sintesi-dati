        <script> 

function checkPW(){
     var TipoLogin=$("#TipoLogin").val();
  
            $.ajax({
                url:"mostraCampi.php",
                type:"POST",
                dataType:"json",
                data:{
                    "TipoLogin":TipoLogin
                },
                success:function(data){
                if(data.Campo==="0"){
                                    $("#Password").val("");
                                    $("#Password1").val("");  
                             
                                
                                }else if(data.Campo==="2"){
                                     $("#Password").val("");
                                    $("#Password1").val("");          
        }
                },
                error:function(){
                    $("#Password").style.display = 'none';
                                    $("#Password1").style.display = 'none';
                                    $("#Dominio").style.display = 'none';
                }  
            })
}

 function campi(){
            var TipoLogin=$("#TipoLogin").val();
  
            $.ajax({
                url:"mostraCampi.php",
                type:"POST",
                dataType:"json",
                data:{
                    "TipoLogin":TipoLogin
                },
                success:function(data){
                if(data.Campo==="0"){
                                    $("#pw").hide();
                                    $("#pw1").hide();
                                    $("#Password").val("");
                                    $("#Password1").val("");
                                    $("#dmn").hide();
                                    $("#obbCambioPw").hide();
                                    $("#resPw").hide();
                                    $("#dataPw").hide();
                                
                                }else if(data.Campo==="1"){
                                        $("#dmn").hide();
                                        $("#pw").show();
                                        $("#pw1").show();
                                        $("#obbCambioPw").show();
                                        $("#resPw").show();
                                        $("#dataPw").show();
//                                        $("#check_Obbligo_cambio_password").prop("checked", false);
//                                        $("#check_Reset_password").prop("checked", false);
                                        
                                }else if(data.Campo==="2"){
                                    $("#pw").hide();
                                    $("#pw1").hide();
                                    $("#Password").val("");
                                    $("#Password1").val("");
                                    $("#dmn").show();
                                    $("#obbCambioPw").hide();
                                    $("#resPw").hide();
                                    $("#dataPw").hide();
                                    
                                    
        }
                },
                error:function(){
                    $("#Password").style.display = 'none';
                                    $("#Password1").style.display = 'none';
                                    $("#Dominio").style.display = 'none';
                }  
            })
        }
        </script>
