        array_push($lista_campi, "Email");
        array_push($lista_valori, $thisEmail);
    }
    if(trim($thisSintesi_dati_progettoInfo->getDelivery_address()) != trim($thisDelivery_address)) {
        $flag_modifica = true;
        array_push($lista_campi, "Delivery address");
        array_push($lista_valori, $thisDelivery_address);
    }
    if(trim($thisSintesi_dati_progettoInfo->getData_consegna_materiale()) != trim($thisData_consegna_materiale)
        || trim($thisSintesi_dati_progettoInfo->getData_consegna_materiale_note()) != trim($thisData_consegna_materiale_note)) {
        $flag_modifica = true;
        array_push($lista_campi, "Data consegna materiale");
        $data_consegna_materiale = date("d/m/Y", strtotime($thisData_consegna_materiale)) . " " . $thisData_consegna_materiale_note;
        array_push($lista_valori, $data_consegna_materiale);
    }
    if(trim($thisSintesi_dati_progettoInfo->getTermine_consegna()) != trim($thisTermine_consegna)
