                        width: 1600,
                        height: w_height,
                        position: ["center"],
                    });
                    delta_dialog.setButtons({
                        <? if ($Op == "Inserisci" && $autorizzazioni->amministratore == true){?>
                        "Inserisci": function(){ submit2("Inserisci"); }, <?} else {?>
                        <? if ($autorizzazioni->amministratore == true){?>
                        "Salva":     function(){ submit2("Salva"); },
                        "Salva e chiudi":  function(){ submit2("Salva_e_chiudi"); },
                        "Copia":     function(){ submit2("Copia"); },
                        "Elimina":   function(){ submit2("Elimina"); },
                        <?}}?>
                        "Chiudi":    function(){
                            delta_dialog.close("done");
                        }
                    });
                }
                else{
                    $("#Inserisci").button();
                    $("#Modifica").button();
                    $("#Elimina").button();
                    $("#Copia").button();
                    $("#Ripristina").button();
                }
            });
            function doRedirect() { //funzione con il link alla pagina che si desidera raggiungere
                if( typeof delta_dialog != "undefined" && typeof top.delta_dialog != "undefined" ){
                    delta_dialog.close("done");
                }
                else{
                    <? if($return!="Close"){ ?>
                    location.href = "view./Sintesi_dati_progetto.php";
                    <? }else{ ?>
                    window.close();
                    parent.CloseDiv();
                    <? } ?>
                }
            }
        </script>
