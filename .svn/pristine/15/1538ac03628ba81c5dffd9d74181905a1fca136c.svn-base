<input type="hidden" id="submit" name="submit" value=""/> 
        <script>
            function submit2(valore){
                submit=valore;
                document.getElementById("submit").value=valore;
                if( typeof delta_dialog != "undefined" && typeof top.delta_dialog != "undefined" ){
                    var form = document.getElementById("sintesi_dati_progettoEditForm");
                    if (form){
                        if(form.onsubmit()){
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    }
                    return false;
                }
                return true;
            }
            function ripristina(){
                window.location=window.location;
            }

            $("#Data_inizio_spedizione").on("change", function() {
                if($("#Data_estrazione_doc_site_manager").val() != "") {
                    var conferma = confirm("Ricalcolare Data di estrazione documentazione site manager?");
                    if(conferma) {
                        var data = new Date($("#Data_inizio_spedizione").val());
                        data.setMonth(data.getMonth() - 2);
                        $("#Data_estrazione_doc_site_manager").val(data.toISOString().split('T')[0]);
                    }
                } else {
                    var data = new Date($("#Data_inizio_spedizione").val());
                    data.setMonth(data.getMonth() - 2);
                    $("#Data_estrazione_doc_site_manager").val(data.toISOString().split('T')[0]);
                }
            })

            $("#Cliente").on("change", function() {
                if($("#Data_primo_invio_doc_cliente").val() != "") {
                    var conferma = confirm("Ricalcolare Data di primo invio documentazione cliente?");
                    if(conferma) {
                        var data = new Date($("#Cliente").val());
                        data.setMonth(data.getMonth() - 2);
                        $("#Data_primo_invio_doc_cliente").val(data.toISOString().split('T')[0]);
                    }
                } else {
                    var data = new Date($("#Cliente").val());
                    data.setMonth(data.getMonth() - 2);
                    $("#Data_primo_invio_doc_cliente").val(data.toISOString().split('T')[0]);
                }
            })

        </script>
        <div class='edit-button'>
            <? if ( $Op=="Inserisci"){ ?> 
            <button id="Inserisci" type="submit"  onclick='submit2("Inserisci");'>Inserisci</button>
            <? }else{ ?> 
            <button id="Salva" type="submit" onclick='submit2("Salva");'>Salva</button>
            <button id="Salva_e_chiudi" type="submit"  onclick='submit2("Salva_e_chiudi");'>Salva e chiudi</button>
            <button id="Copia" type="submit"  onclick='submit2("Copia");'>Copia</button>
            <button id="Elimina" type="submit"  onclick='submit2("Elimina");'>Elimina</button>
            <? } ?> 
            <button id="Ripristina" type="button"  onclick='ripristina();'>Ripristina</button>
        </div>
</form>
</div>
    </body>
</html>