        array_push($lista_campi, "Numero supercommessa / job");
        array_push($lista_valori, $thisNumero_supercommessa_job);
    }
    if(trim($thisSintesi_dati_progettoInfo->getPm_tt()) != trim($thisPm_tt)) {
        $flag_modifica = true;
        array_push($lista_campi, "PM TT");
        array_push($lista_valori, $thisPm_tt);
    }
    if(trim($thisSintesi_dati_progettoInfo->getPm_customer()) != trim($thisPm_customer)) {
        $flag_modifica = true;
        array_push($lista_campi, "PM Customer");
        array_push($lista_valori, $thisPm_customer);
    }
    if(trim($thisSintesi_dati_progettoInfo->getEmail()) != trim($thisEmail)) {
