        $flag_modifica = false;
    $lista_valori = [];
    $lista_campi = [];
    if(trim($thisSintesi_dati_progettoInfo->Acronimo_progetto) != trim($thisAcronimo_progetto)) {
        $flag_modifica = true;
        array_push($lista_campi, "Acronimo progetto");
        array_push($lista_valori, $thisAcronimo_progetto);
    }
    if(trim($thisSintesi_dati_progettoInfo->getRagione_sociale_cliente()) != trim($thisRagione_sociale_cliente)) {
        $flag_modifica = true;
        array_push($lista_campi, "Ragione sociale cliente");
        array_push($lista_valori, $thisRagione_sociale_cliente);
    }
    if(trim($thisSintesi_dati_progettoInfo->getArea()) != trim($thisArea)) {
        $flag_modifica = true;
        array_push($lista_campi, "Area");
        array_push($lista_valori, $thisArea);
    }
    if(trim($thisSintesi_dati_progettoInfo->getData_contratto()) != trim($thisData_contratto)) {
        $flag_modifica = true;
        array_push($lista_campi, "Data contratto");
        array_push($lista_valori, date("d/m/Y", strtotime($thisData_contratto)));
    }
    if(trim($thisSintesi_dati_progettoInfo->getScopo_fornitura()) != trim($thisScopo_fornitura)) {
        $flag_modifica = true;
        array_push($lista_campi, "Scopo fornitura");
        array_push($lista_valori, $thisScopo_fornitura);
    }
    if(trim($thisSintesi_dati_progettoInfo->getNumero_supercommessa_job()) != trim($thisNumero_supercommessa_job)) {
