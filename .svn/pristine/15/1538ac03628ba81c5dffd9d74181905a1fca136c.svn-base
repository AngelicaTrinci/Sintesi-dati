        $flag_modifica = true;
        array_push($lista_campi, "Penali su consegna");
        switch($thisPenali_su_consegna) {
            case "S":
                $var = "Si";
                break;
            case "N":
                $var = "No";
                break;
        }
        $penali_su_consegna = $var . " " . $thisPenali_su_consegna_note;
        array_push($lista_valori, $penali_su_consegna);
